# ============================================================
# LARGE MODEL / BINARY FILES — never commit to GitLab
# GitLab default file limit is 100 MB; these exceed it.
# Store separately (shared drive / object storage / Git LFS).
# ============================================================

# PyTorch weights
*.pth
*.pt

# Scikit-learn / XGBoost serialized models
*.joblib
*.pkl
*.pickle

# Safetensors (HuggingFace)
*.safetensors

